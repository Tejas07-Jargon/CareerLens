# CareerLens Backend – Environment Variables
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development              # development | production
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# For demo/hackathon use SQLite by leaving DATABASE_URL blank; the app
# falls back to a local SQLite file automatically.
DATABASE_URL=postgresql://careerlens:careerlens@localhost:5432/careerlens
# DATABASE_URL=                  # uncomment to use SQLite fallback

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── GitHub ───────────────────────────────────────────────────────────────────
# A Personal Access Token is MANDATORY: unauthenticated requests are capped
# at 60/hour; authenticated at 5,000/hour.
GITHUB_TOKEN=ghp_your_token_here

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=                  # optional fallback / vision

# LLM model tiers
LLM_FAST_MODEL=gemini-1.5-flash  # bulk extraction (cheap, fast)
LLM_STRONG_MODEL=gemini-1.5-pro  # roadmap & explanations (quality)

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2  # local sentence-transformer; no API key needed

# ── GitHub analysis limits (safety) ──────────────────────────────────────────
GITHUB_MAX_REPOS_FAST=20         # repos fetched in fast pass
GITHUB_MAX_REPOS_DEEP=5          # repos cloned in deep pass
GITHUB_MAX_CLONE_MB=50           # abort clone if repo exceeds this size

# ── Scoring thresholds ───────────────────────────────────────────────────────
EVIDENCE_VERIFIED_THRESHOLD=0.6
EVIDENCE_PARTIAL_THRESHOLD=0.25
SMALL_COHORT_MIN_SIZE=5          # suppress stats below this group size

# ── Voice (optional, lowest priority) ───────────────────────────────────────
ELEVENLABS_API_KEY=              # leave blank to disable voice features

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
